# ═══════════════════════════════════════════════════════════════════════════════
# MAJAL ISP — Backend Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to git.
# ═══════════════════════════════════════════════════════════════════════════════

# ── DATABASE (Supabase PostgreSQL) ────────────────────────────────────────────
# Get this from: Supabase → Settings → Database → Connection string → URI
# Use port 5432 (session mode) for Prisma.
DATABASE_URL="postgresql://postgres:x2lg1vhbPd5Ck04Y@db.mkesogomwgxflgjzxtkd.supabase.co:5432/postgres"

# ── AUTH ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# ── SERVER ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV="production"

# ── BACHS PAYMENT GATEWAY ────────────────────────────────────────────────────
# Get keys from your Bachs merchant dashboard
BACHS_API_KEY="sk_sandbox_your-bachs-api-key"
BACHS_WEBHOOK_SECRET="your-bachs-webhook-secret"
# Optional comma-separated payment methods (e.g., MPESA,CARD)
# BACHS_PAYMENT_METHODS="MPESA,CARD"

# ── SMS — Africa's Talking ────────────────────────────────────────────────────
# https://account.africastalking.com/apps/sandbox/settings/key
AFRICASTALKING_USERNAME="majalisp"
AFRICASTALKING_API_KEY="your-africastalking-api-key"

# ── EMAIL (optional) ─────────────────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"

# ── WIREGUARD CGNAT TUNNEL ───────────────────────────────────────────────────
# Required for MikroTik routers behind CGNAT/LTE. Runs on the backend Linux VPS.
# Generate keypair: wg genkey | tee privatekey | wg pubkey > publickey
WIREGUARD_INTERFACE="wg0"
WIREGUARD_SERVER_ENDPOINT="vpn.yourdomain.com:51820"
WIREGUARD_SERVER_PUBLIC_KEY="your-wireguard-server-public-key"
WIREGUARD_SUBNET="10.250.0.0/24"

# ── CAPTIVE PORTAL ───────────────────────────────────────────────────────────
# The public domain of your customer-facing portal (used in MikroTik walled-garden rules)
PORTAL_DOMAIN="wifi.yourdomain.com"

# ── FRONTEND URL ─────────────────────────────────────────────────────────────
# Your deployed frontend URL — used for CORS origin.
FRONTEND_URL="https://your-frontend.vercel.app"

# ── ADMIN SEED CREDENTIALS ───────────────────────────────────────────────────
# Used only by: npm run db:seed
# Change immediately after first login.
ADMIN_EMAIL="admin@majalisp.com"
ADMIN_PASSWORD="change-me-in-production"
