# Database
DATABASE_URL="postgresql://username:password@localhost:5432/collospot_db"

# JWT
JWT_SECRET="your-super-secret-jwt-key-here"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV="development"

# Bachs Payment Gateway
BACHS_API_KEY="sk_sandbox_your-bachs-api-key"
BACHS_WEBHOOK_SECRET="your-bachs-webhook-secret"
# BACHS_PAYMENT_METHODS="MPESA,CARD"

# SMS (Africa's Talking)
AFRICASTALKING_USERNAME="sandbox"
AFRICASTALKING_API_KEY="your-africastalking-api-key"

# WhatsApp (Optional)
WHATSAPP_TOKEN="your-whatsapp-token"
WHATSAPP_PHONE_ID="your-phone-number-id"

# WireGuard Tunnel Configuration (CGNAT Traversal for Remote MikroTik Routers)
WIREGUARD_INTERFACE="wg0"
WIREGUARD_SERVER_ENDPOINT="vpn.example.com:51820"
WIREGUARD_SERVER_PUBLIC_KEY="your-wireguard-server-public-key"
WIREGUARD_SUBNET="10.250.0.0/24"

# Captive Portal Domain (used in RouterOS walled-garden and hotspot login redirect scripts)
PORTAL_DOMAIN="wifi.majal.example.com"

# Email (Optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Frontend URL
FRONTEND_URL="http://localhost:3000"

# Admin Credentials
ADMIN_EMAIL="admin@mwakidenis50gmail.com"
ADMIN_PASSWORD="admin123"
